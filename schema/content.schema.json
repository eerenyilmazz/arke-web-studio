{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "tagline": {
      "type": "string",
      "minLength": 1,
      "maxLength": 90
    },
    "hero": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "subtitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "ctaLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30
        }
      },
      "required": [
        "title",
        "subtitle",
        "ctaLabel"
      ]
    },
    "about": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "body": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "required": [
        "title",
        "body"
      ]
    },
    "services": {
      "minItems": 1,
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "price": {
            "type": "string",
            "maxLength": 40
          },
          "icon": {
            "type": "string",
            "enum": [
              "code",
              "mobile",
              "globe",
              "qr",
              "box",
              "chart",
              "cart",
              "scissors",
              "tooth",
              "home",
              "hammer",
              "leaf",
              "car",
              "scales",
              "heart",
              "cup",
              "bread",
              "sparkle",
              "shield",
              "clock",
              "calendar",
              "chat",
              "camera",
              "star"
            ]
          }
        },
        "required": [
          "title",
          "description"
        ]
      }
    },
    "gallery": {
      "default": [],
      "maxItems": 24,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "src": {
            "type": "string",
            "pattern": "^assets\\/[a-z0-9][a-z0-9._-]{0,80}$"
          },
          "alt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150
          }
        },
        "required": [
          "src",
          "alt"
        ]
      }
    },
    "testimonials": {
      "default": [],
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "quote": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          },
          "author": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          }
        },
        "required": [
          "quote",
          "author"
        ]
      }
    },
    "faq": {
      "default": [],
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "question": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150
          },
          "answer": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          }
        },
        "required": [
          "question",
          "answer"
        ]
      }
    },
    "contact": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "intro": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        }
      },
      "required": [
        "title",
        "intro"
      ]
    },
    "process": {
      "default": [],
      "maxItems": 6,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 220
          }
        },
        "required": [
          "title",
          "description"
        ]
      }
    },
    "highlights": {
      "default": [],
      "maxItems": 4,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        },
        "required": [
          "title",
          "text"
        ]
      }
    },
    "whatsappMessage": {
      "type": "string",
      "maxLength": 200
    },
    "seo": {
      "type": "object",
      "properties": {
        "home": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            }
          },
          "required": [
            "title",
            "description"
          ]
        },
        "about": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            }
          },
          "required": [
            "title",
            "description"
          ]
        },
        "services": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            }
          },
          "required": [
            "title",
            "description"
          ]
        },
        "gallery": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            }
          },
          "required": [
            "title",
            "description"
          ]
        },
        "contact": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            }
          },
          "required": [
            "title",
            "description"
          ]
        }
      },
      "required": [
        "home"
      ]
    }
  },
  "required": [
    "tagline",
    "hero",
    "about",
    "services",
    "contact",
    "seo"
  ]
}
