{
  "name": "arke-web-studio",
  "version": "2.3.1",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "author": "Eren Yılmaz <eerenyilmazz1@gmail.com>",
  "description": "MCP server + rules for producing small-business showcase websites from a fixed template and a validated config.",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "bin": {
    "arke-web-mcp": "dist/server.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run tests/e2e.test.ts tests/e2e-portal.test.ts tests/e2e-i18n.test.ts",
    "test:click": "ARKE_CLICK=1 vitest run tests/click-through.test.ts",
    "schema": "tsx src/cli/export-schema.ts",
    "approve": "tsx src/cli/approve.ts",
    "report": "tsx src/cli/report.ts",
    "restore-backup": "tsx src/cli/restore-backup.ts",
    "panel": "npm run build && node dist/panel/server.js",
    "lint": "biome lint",
    "format": "biome format --write src panel/js panel/app.js portal tests scripts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "wrangler": "^4.151.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "^22.20.5",
    "impeccable": "4.5.2",
    "playwright-core": "^1.56.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
