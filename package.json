{
  "name": "site-factory",
  "version": "0.4.3",
  "private": true,
  "description": "MCP server + rules for producing small-business showcase websites from a fixed template and a validated config.",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "bin": {
    "site-factory-mcp": "dist/server.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "schema": "tsx src/cli/export-schema.ts",
    "approve": "tsx src/cli/approve.ts",
    "panel": "npm run build && node dist/panel/server.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "wrangler": "^4.151.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "impeccable": "4.5.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
