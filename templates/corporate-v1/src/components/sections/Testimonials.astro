---
import type { PageContext } from "../../lib/site";

interface Props { readonly ctx: PageContext }
const { ctx } = Astro.props;
const { testimonials } = ctx.content;
const variant = ctx.config.design.variants.testimonials;
const [first, ...rest] = testimonials;
---
{first && (
  <section class="wrap band">
    <h2 class="h-section">{ctx.t.testimonialsTitle}</h2>

    {variant === "a" && (
      <>
        <figure class="mt-10 max-w-3xl">
          <blockquote class="font-heading text-2xl leading-snug md:text-3xl"><p>“{first.quote}”</p></blockquote>
          <figcaption class="mt-4 font-semibold">{first.author}</figcaption>
        </figure>
        {rest.length > 0 && (
          <div class="mt-12 grid gap-8 md:grid-cols-2">
            {rest.map((q) => (
              <figure class="rule-t pt-5">
                <blockquote><p>“{q.quote}”</p></blockquote>
                <figcaption class="mt-2 font-semibold">{q.author}</figcaption>
              </figure>
            ))}
          </div>
        )}
      </>
    )}

    {variant === "b" && (
      <div class="mt-10 grid gap-x-12 gap-y-10 md:grid-cols-2">
        {testimonials.map((q) => (
          <figure class="border-s-2 border-primary ps-6">
            <blockquote class="text-lg"><p>“{q.quote}”</p></blockquote>
            <figcaption class="mt-3 font-semibold">{q.author}</figcaption>
          </figure>
        ))}
      </div>
    )}

    {variant === "c" && (
      <ul class="mt-10 flex snap-x gap-5 overflow-x-auto pb-4">
        {testimonials.map((q) => (
          <li class="w-80 shrink-0 snap-start rounded-md bg-secondary p-7 text-on-secondary">
            <figure>
              <blockquote><p>“{q.quote}”</p></blockquote>
              <figcaption class="mt-3 font-semibold">{q.author}</figcaption>
            </figure>
          </li>
        ))}
      </ul>
    )}
  </section>
)}
