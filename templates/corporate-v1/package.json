{
  "name": "corporate-v1",
  "version": "1.0.0",
  "private": true,
  "description": "Arke Web Studio template: static showcase site for a small business, built from one client folder.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "types": "node scripts/gen-types.mjs",
    "types:check": "node scripts/gen-types.mjs --check"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.3.3",
    "ajv": "8.20.0",
    "astro": "7.3.8",
    "image-size": "2.0.4",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "json-schema-to-typescript": "16.0.0",
    "typescript": "5.9.3"
  }
}
