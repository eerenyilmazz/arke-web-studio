---
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { darkPalette, mix, readableAccent, readableOn, type Palette } from "../lib/color";
import { faviconPath, faviconType } from "../lib/files";
import { fontStack } from "../lib/fonts";
import { localBusinessJsonLd } from "../lib/seo";
import type { PageContext } from "../lib/site";
import { displayPhone, heroImage, whatsappHref } from "../lib/site";

interface Props {
  readonly ctx: PageContext;
  readonly title: string;
  readonly description: string;
  /** Page is not one of the site's pages (404): no canonical, no alternates. */
  readonly standalone?: boolean;
}
const { ctx, title, description, standalone = false } = Astro.props;
const { config, site, locale, page, t } = ctx;
const p = config.design.palette;
const darkMode = config.design.darkMode === "auto";

/** Colour variables for one palette. The ink surface is the strongly contrasting band (footer, quotes). */
function colourVars(c: Palette, dark: boolean): string {
  const cta = readableAccent(c.accent, c.text, null);
  const ink = dark ? mix(c.background, "#FFFFFF", 0.07) : c.text;
  return [
    `--c-primary:${c.primary}`, `--c-on-primary:${readableOn(c.primary, c.text)}`,
    `--c-secondary:${c.secondary}`, `--c-on-secondary:${readableOn(c.secondary, c.text)}`,
    `--c-accent:${c.accent}`, `--c-on-accent:${readableOn(c.accent, c.text)}`,
    // Accent for buttons/blocks with text on it, and for accent-coloured text on the page background.
    `--c-cta:${cta}`, `--c-on-cta:${readableOn(cta, c.text)}`,
    `--c-accent-ink:${readableAccent(c.accent, c.text, c.background, dark ? "lighten" : "darken")}`,
    `--c-background:${c.background}`, `--c-text:${c.text}`,
    `--c-ink-surface:${ink}`, `--c-on-ink-surface:${dark ? c.text : c.background}`,
  ].join(";");
}
const dark = darkPalette(p);
// Brand secondary stays the same in both themes: decoration on the always-dark hero uses it.
const fontVars = `--f-heading:${fontStack(config.design.fonts.heading)};--f-body:${fontStack(config.design.fonts.body)};--c-brand-secondary:${p.secondary}`;
const darkVars = `${colourVars(dark, true)};color-scheme:dark;--card-shadow:none`;
// Values are validated hex colours and sanitised font names, so this block cannot carry client markup.
const themeCss = [
  `:root{${colourVars(p, false)};${fontVars}}`,
  darkMode ? `@media (prefers-color-scheme: dark){:root:not([data-theme="light"]){${darkVars}}}` : "",
  darkMode ? `:root[data-theme="dark"]{${darkVars}}` : "",
].join("");

const abs = (path: string) => (site.baseUrl ? `${site.baseUrl}${path}` : path);
const canonical = standalone ? null : abs(ctx.url(page));
const alternates = standalone ? [] : config.i18n.locales.map((l) => ({ lang: l, href: abs(ctx.url(page, l)) }));
const ogImage = site.baseUrl ? (heroImage(ctx)?.src ?? (config.brand.logo ? `/${config.brand.logo}` : null)) : null;
const favicon = faviconPath(config);
const jsonLd = page === "home" && !standalone ? localBusinessJsonLd(ctx) : null;
const wa = config.whatsapp;
---
<!doctype html>
<html lang={locale} dir={ctx.dir} data-personality={config.design.personality}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content={p.primary} />
    {darkMode && <meta name="theme-color" media="(prefers-color-scheme: dark)" content={dark.background} />}
    <style is:inline set:html={themeCss} />
    {/* Applies a saved light/dark choice before the first paint, so the page does not flash. */}
    {darkMode && <script is:inline>try{var t=localStorage.getItem("arke-theme");if(t==="light"||t==="dark")document.documentElement.dataset.theme=t}catch(e){}</script>}
    {site.baseUrl && canonical && <link rel="canonical" href={canonical} />}
    {alternates.length > 1 && alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
    {alternates.length > 1 && <link rel="alternate" hreflang="x-default" href={abs(ctx.url(page, config.i18n.defaultLocale))} />}
    <link rel="icon" href={favicon} type={faviconType(favicon)} />
    <link rel="stylesheet" href="/fonts/fonts.css" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={config.business.name} />
    <meta property="og:locale" content={locale} />
    {site.baseUrl && canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={abs(ogImage)} />}
    <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
    {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
  </head>
  <body class="min-h-dvh flex flex-col antialiased">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:m-3 focus:p-3 focus:bg-bg">{t.skipToContent}</a>
    <Header ctx={ctx} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer ctx={ctx} />
    {wa.floatingButton && wa.number && (
      <a
        href={whatsappHref(wa.number, ctx.content.whatsappMessage)}
        target="_blank"
        rel="noopener"
        class="btn btn-accent fixed bottom-5 end-5 z-40 shadow-[0_6px_20px_rgb(0_0_0/0.2)]"
        aria-label={`${t.chatOnWhatsapp} ${displayPhone(wa.number)} ${t.opensInNewTab}`}
      >
        {t.whatsapp}
      </a>
    )}
  </body>
</html>
