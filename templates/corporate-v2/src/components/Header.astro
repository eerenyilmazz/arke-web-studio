---
import type { PageContext } from "../lib/site";
import { primaryCta, sectorFamily } from "../lib/site";

interface Props { readonly ctx: PageContext }
const { ctx } = Astro.props;
const { config, site, t, page } = ctx;
const logo = config.brand.logo ? site.images.get(config.brand.logo) : null;
const cta = primaryCta(ctx);
const links = config.pages.filter((p) => p !== "home").map((p) => ({ id: p, href: ctx.url(p), label: t.nav[p] }));
// Bold sites open on a dark hero: the header joins it on the home page.
const family = sectorFamily(config);
// Bold, food and trades sites open every page on a dark band (home hero or page hero): the header joins it.
const onHero = config.design.personality === "bold" || family === "food" || family === "trades";
const external = cta.external ? { target: "_blank", rel: "noopener" } : {};
const darkMode = config.design.darkMode === "auto";
---
<header class:list={["relative z-20", onHero ? "bg-primary text-on-primary" : "bg-bg rule-b"]}>
  <div class="wrap flex items-center justify-between gap-6 py-4">
    <a href={ctx.url("home")} class="flex items-center gap-3 no-underline min-h-11" aria-label={config.business.name}>
      {logo
        ? <img src={logo.src} alt="" width={logo.width} height={logo.height} class="h-10 w-auto max-w-44 object-contain" />
        : <span class="font-heading text-2xl" style="font-weight: var(--h-weight); letter-spacing: var(--h-tracking)">{config.business.name}<span class:list={[onHero ? "text-accent" : "text-accent-ink"]}>.</span></span>}
    </a>

    <nav aria-label={t.mainNav} class="hidden md:block">
      <ul class="flex items-center gap-1">
        {links.map((l) => (
          <li>
            <a href={l.href} class:list={["block rounded-full px-4 py-2 no-underline transition-colors hover:bg-[color-mix(in_srgb,currentColor_9%,transparent)]", l.id === page && "underline decoration-2 underline-offset-8"]} aria-current={l.id === page ? "page" : undefined}>{l.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="flex items-center gap-2">
    {darkMode && (
      <button type="button" class="theme-toggle" data-theme-toggle aria-label={t.themeToggle} title={t.themeToggle}>
        <svg class="sun" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4.5" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
        <svg class="moon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5a8.5 8.5 0 1 0 11 11z" /></svg>
      </button>
    )}
    <a href={cta.href} class="btn btn-accent hidden md:inline-flex" {...external}>{cta.label}{cta.external && <span class="sr-only"> {t.opensInNewTab}</span>}</a>

    <details class="md:hidden relative">
      <summary class="btn btn-ghost cursor-pointer list-none">{t.menu}</summary>
      <nav aria-label={t.mainNav} class="absolute end-0 z-30 mt-2 w-64 bg-bg text-ink p-4 shadow-[0_10px_30px_rgb(0_0_0/0.15)]" style="border-radius: var(--radius)">
        <ul class="flex flex-col gap-1">
          <li><a href={ctx.url("home")} class="block py-2.5 no-underline">{t.nav.home}</a></li>
          {links.map((l) => <li><a href={l.href} class="block py-2.5 no-underline" aria-current={l.id === page ? "page" : undefined}>{l.label}</a></li>)}
        </ul>
        <a href={cta.href} class="btn btn-accent mt-3 w-full" {...external}>{cta.label}</a>
      </nav>
    </details>
    </div>
  </div>
</header>

<script>
  // Light/dark switch: remembers the choice on this device only (no cookie), and cross-fades where supported.
  const STORAGE_KEY = "arke-theme";
  const root = document.documentElement;
  const isDark = () => (root.dataset.theme ? root.dataset.theme === "dark" : matchMedia("(prefers-color-scheme: dark)").matches);
  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]")) {
    button.setAttribute("aria-pressed", String(isDark()));
    button.addEventListener("click", () => {
      const next = isDark() ? "light" : "dark";
      const apply = () => {
        root.dataset.theme = next;
        button.setAttribute("aria-pressed", String(next === "dark"));
      };
      const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
      const doc = document as Document & { startViewTransition?: (cb: () => void) => unknown };
      if (doc.startViewTransition && !reduce) doc.startViewTransition(apply);
      else apply();
      try { localStorage.setItem(STORAGE_KEY, next); } catch { /* private mode: the choice lasts for this page only */ }
    });
  }
</script>
