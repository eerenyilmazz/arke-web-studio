---
import type { PageContext } from "../../lib/site";
import { sectionsFor, sectorFamily } from "../../lib/site";
import Beauty from "./highlights/Beauty.astro";
import Standard from "./highlights/Standard.astro";

/* Sector layouts (beauty, health, trades) have their own version; food and everything else use Standard. */
interface Props { readonly ctx: PageContext }
const { ctx } = Astro.props;
const family = sectorFamily(ctx.config);
const BY_FAMILY = { beauty: Beauty, health: null, trades: null } as const;
const Chosen = family && family !== "food" ? BY_FAMILY[family] : Standard;
// Health and trades show the facts inside their hero; repeat them only on pages without a hero.
const inHero = sectionsFor(ctx.config, ctx.page).includes("hero");
const Section = Chosen === null ? (inHero ? null : Standard) : Chosen;
---
{Section && <Section ctx={ctx} />}
