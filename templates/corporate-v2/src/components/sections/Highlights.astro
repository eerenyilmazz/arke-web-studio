---
import type { PageContext } from "../../lib/site";

/* Short facts the client gave (years in business, area covered, response time). Never invented: empty = hidden. */
interface Props { readonly ctx: PageContext }
const { ctx } = Astro.props;
const { highlights } = ctx.content;
const p = ctx.config.design.personality;
---
{highlights.length > 0 && (
  <section class:list={[p === "bold" ? "surface-ink" : p === "friendly" ? "" : "rule-b"]}>
    <ul class:list={["wrap reveal-stagger grid gap-6 py-10 md:py-12", highlights.length > 2 ? "sm:grid-cols-2 lg:grid-cols-4" : "sm:grid-cols-2"]}>
      {highlights.map((h) => (
        <li class:list={[p === "friendly" && "card tint-accent p-6", p === "premium" && "border-s ps-5 border-[var(--color-rule)]"]}>
          <p class:list={["num leading-none", p === "bold" ? "text-4xl md:text-5xl text-accent" : "text-3xl md:text-4xl"]}>{h.title}</p>
          <p class="mt-2 opacity-85">{h.text}</p>
        </li>
      ))}
    </ul>
  </section>
)}
