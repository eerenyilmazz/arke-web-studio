---
import type { PageContext } from "../../lib/site";
import { sectorFamily } from "../../lib/site";
import Beauty from "./services/Beauty.astro";
import Health from "./services/Health.astro";
import Trades from "./services/Trades.astro";
import Standard from "./services/Standard.astro";

/* Sector layouts (beauty, health, trades) have their own version; food and everything else use Standard. */
interface Props { readonly ctx: PageContext }
const { ctx } = Astro.props;
const family = sectorFamily(ctx.config);
const BY_FAMILY = { beauty: Beauty, health: Health, trades: Trades } as const;
const Chosen = family && family !== "food" ? BY_FAMILY[family] : Standard;
const Section = Chosen;
---
{Section && <Section ctx={ctx} />}
