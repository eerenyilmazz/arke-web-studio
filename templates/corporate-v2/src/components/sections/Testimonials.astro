---
import type { PageContext } from "../../lib/site";

interface Props { readonly ctx: PageContext }
const { ctx } = Astro.props;
const { testimonials } = ctx.content;
const p = ctx.config.design.personality;
const [first, ...rest] = testimonials;
---
{first && p === "bold" && (
  <section class="surface-ink">
    <div class="wrap band">
      <h2 class="eyebrow opacity-80 reveal">{ctx.t.testimonialsTitle}</h2>
      <figure class="reveal mt-8 max-w-4xl">
        <blockquote class="font-heading text-[clamp(1.7rem,3.6vw,2.9rem)] leading-tight" style="font-weight: var(--h-weight); letter-spacing: var(--h-tracking)"><p><span class="text-accent">“</span>{first.quote}<span class="text-accent">”</span></p></blockquote>
        <figcaption class="mt-6 font-semibold">— {first.author}</figcaption>
      </figure>
      {rest.length > 0 && (
        <div class="reveal-stagger mt-14 grid gap-8 md:grid-cols-2">
          {rest.map((q) => (
            <figure class="border-t pt-6 border-[color-mix(in_srgb,currentColor_20%,transparent)]">
              <blockquote><p>“{q.quote}”</p></blockquote>
              <figcaption class="mt-3 font-semibold">{q.author}</figcaption>
            </figure>
          ))}
        </div>
      )}
    </div>
  </section>
)}

{first && p === "premium" && (
  <section class="wrap band text-center">
    <h2 class="eyebrow text-accent-ink reveal">{ctx.t.testimonialsTitle}</h2>
    <figure class="reveal mx-auto mt-8 max-w-3xl">
      <blockquote class="font-heading text-[clamp(1.6rem,3.2vw,2.5rem)] leading-snug"><p>“{first.quote}”</p></blockquote>
      <figcaption class="mt-6 muted">{first.author}</figcaption>
    </figure>
    {rest.length > 0 && (
      <div class:list={["reveal-stagger mx-auto mt-14 grid gap-8 text-start", rest.length > 1 ? "max-w-5xl md:grid-cols-2" : "max-w-xl"]}>
        {rest.map((q) => (
          <figure class="rule-t pt-6">
            <blockquote><p>“{q.quote}”</p></blockquote>
            <figcaption class="mt-3 muted">{q.author}</figcaption>
          </figure>
        ))}
      </div>
    )}
  </section>
)}

{first && p === "friendly" && (
  <section class="wrap band">
    <h2 class="h-section reveal">{ctx.t.testimonialsTitle}</h2>
    <ul class="reveal-stagger mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {testimonials.map((q, i) => (
        <li class:list={["card p-7", i % 2 === 0 ? "tint-accent" : "tint-secondary"]}>
          <figure>
            <p aria-hidden="true" class="num text-5xl leading-none text-accent-ink">“</p>
            <blockquote class="mt-2 text-lg"><p>{q.quote}</p></blockquote>
            <figcaption class="mt-4 font-semibold">{q.author}</figcaption>
          </figure>
        </li>
      ))}
    </ul>
  </section>
)}
